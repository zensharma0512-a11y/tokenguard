{
  "providers": {
    "openai":    { "type": "openai",    "base_url": "https://api.openai.com/v1", "api_key_env": "OPENAI_API_KEY" },
    "anthropic": { "type": "anthropic", "base_url": "https://api.anthropic.com", "api_key_env": "ANTHROPIC_API_KEY" },
    "local":     { "type": "openai",    "base_url": "http://localhost:11434/v1", "api_key_env": "OLLAMA_KEY" }
  },
  "models": {
    "fast": {
      "routes": [
        { "provider": "openai",    "model": "YOUR-OPENAI-MODEL",    "input_usd_per_mtok": 0.15, "output_usd_per_mtok": 0.60 },
        { "provider": "anthropic", "model": "YOUR-ANTHROPIC-MODEL", "input_usd_per_mtok": 1.00, "output_usd_per_mtok": 5.00 }
      ]
    },
    "free": {
      "routes": [
        { "provider": "local", "model": "llama3.2", "input_usd_per_mtok": 0, "output_usd_per_mtok": 0 }
      ]
    }
  },
  "limits": { "default_max_tokens": 1024, "max_tokens_limit": 8192 },
  "cache": { "ttl_seconds": 3600 }
}
